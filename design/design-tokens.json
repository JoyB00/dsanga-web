{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "D'Sanga Pool, Bistro & Space — design tokens v1 (approved style tile). Source of truth. Regenerate design-tokens.css after editing.",

  "primitive": {
    "color": {
      "forest": {
        "700": { "$value": "#1F4D3A", "$type": "color", "$description": "Brand green" },
        "800": { "$value": "#163828", "$type": "color", "$description": "Brand green, pressed/hover" }
      },
      "leaf": {
        "100": { "$value": "#E4EEE3", "$type": "color" },
        "600": { "$value": "#3F7D52", "$type": "color" }
      },
      "gold": {
        "300": { "$value": "#E2C58F", "$type": "color", "$description": "Light gold, only on dark green" },
        "500": { "$value": "#C8963E", "$type": "color", "$description": "Decorative only — 2.4:1 on cream, never body text" },
        "800": { "$value": "#8A5A1C", "$type": "color", "$description": "Text-safe gold (5.3:1 on cream)" }
      },
      "terracotta": {
        "700": { "$value": "#A4532F", "$type": "color" }
      },
      "cream": {
        "50": { "$value": "#F7F3EA", "$type": "color" },
        "100": { "$value": "#EFE7D6", "$type": "color", "$description": "Sand" },
        "200": { "$value": "#E1D8C3", "$type": "color" },
        "300": { "$value": "#D9CFBB", "$type": "color" }
      },
      "stone": {
        "500": { "$value": "#8C8676", "$type": "color" },
        "700": { "$value": "#5B6358", "$type": "color" },
        "900": { "$value": "#1F2A24", "$type": "color", "$description": "Ink" }
      },
      "red": {
        "700": { "$value": "#B42318", "$type": "color" }
      },
      "white": { "$value": "#FFFFFF", "$type": "color" }
    },
    "font": {
      "display": { "$value": "'Caveat', cursive", "$type": "fontFamily" },
      "sans": { "$value": "'Nunito Sans', system-ui, sans-serif", "$type": "fontFamily" }
    },
    "radius": {
      "12": { "$value": "12px", "$type": "dimension" },
      "20": { "$value": "20px", "$type": "dimension" },
      "32": { "$value": "32px", "$type": "dimension" },
      "pill": { "$value": "9999px", "$type": "dimension" }
    },
    "shadow": {
      "sm": { "$value": "0 2px 8px rgba(31, 42, 36, 0.06)", "$type": "shadow" },
      "md": { "$value": "0 12px 32px rgba(31, 42, 36, 0.10)", "$type": "shadow" }
    },
    "space": {
      "1": { "$value": "8px", "$type": "dimension" },
      "2": { "$value": "16px", "$type": "dimension" },
      "3": { "$value": "24px", "$type": "dimension" },
      "4": { "$value": "32px", "$type": "dimension" },
      "6": { "$value": "48px", "$type": "dimension" },
      "8": { "$value": "64px", "$type": "dimension" },
      "12": { "$value": "96px", "$type": "dimension" }
    },
    "duration": {
      "fast": { "$value": "150ms", "$type": "duration" },
      "base": { "$value": "200ms", "$type": "duration" },
      "reveal": { "$value": "350ms", "$type": "duration" }
    }
  },

  "semantic": {
    "ds": {
      "color": {
        "background": { "$value": "{primitive.color.cream.50}", "$type": "color" },
        "surface": { "$value": "{primitive.color.white}", "$type": "color", "$description": "Cards, forms, header" },
        "surface-alt": { "$value": "{primitive.color.cream.100}", "$type": "color", "$description": "Alternating sections" },
        "foreground": { "$value": "{primitive.color.stone.900}", "$type": "color", "$description": "13.4:1 on background" },
        "muted-foreground": { "$value": "{primitive.color.stone.700}", "$type": "color", "$description": "5.6:1 on background" },
        "primary": { "$value": "{primitive.color.forest.700}", "$type": "color" },
        "primary-hover": { "$value": "{primitive.color.forest.800}", "$type": "color" },
        "on-primary": { "$value": "{primitive.color.white}", "$type": "color", "$description": "9.6:1 on primary" },
        "secondary": { "$value": "{primitive.color.leaf.600}", "$type": "color" },
        "highlight": { "$value": "{primitive.color.leaf.100}", "$type": "color", "$description": "Icon circles, Available badge, tinted sections" },
        "accent": { "$value": "{primitive.color.gold.500}", "$type": "color", "$description": "Decoration and focus ring only" },
        "accent-text": { "$value": "{primitive.color.gold.800}", "$type": "color", "$description": "Eyebrows, small gold labels" },
        "accent-on-dark": { "$value": "{primitive.color.gold.300}", "$type": "color", "$description": "Gold text on green footer" },
        "warm": { "$value": "{primitive.color.terracotta.700}", "$type": "color", "$description": "Coming Soon, offer tags" },
        "on-warm": { "$value": "{primitive.color.white}", "$type": "color", "$description": "5.4:1 on warm" },
        "border": { "$value": "{primitive.color.cream.300}", "$type": "color", "$description": "Decorative dividers only (not for controls)" },
        "placeholder": { "$value": "{primitive.color.cream.200}", "$type": "color" },
        "input-border": { "$value": "{primitive.color.stone.500}", "$type": "color", "$description": "3.6:1 — meets 3:1 for UI controls" },
        "danger": { "$value": "{primitive.color.red.700}", "$type": "color" },
        "ring": { "$value": "{primitive.color.gold.500}", "$type": "color" }
      },
      "font": {
        "display": { "$value": "{primitive.font.display}", "$type": "fontFamily", "$description": "h1/h2 only, ≥32px" },
        "body": { "$value": "{primitive.font.sans}", "$type": "fontFamily" }
      },
      "radius": {
        "control": { "$value": "{primitive.radius.12}", "$type": "dimension" },
        "card": { "$value": "{primitive.radius.20}", "$type": "dimension" },
        "media": { "$value": "{primitive.radius.32}", "$type": "dimension" },
        "pill": { "$value": "{primitive.radius.pill}", "$type": "dimension" }
      },
      "shadow": {
        "card": { "$value": "{primitive.shadow.sm}", "$type": "shadow" },
        "raised": { "$value": "{primitive.shadow.md}", "$type": "shadow" }
      },
      "space": {
        "section-desktop": { "$value": "{primitive.space.12}", "$type": "dimension" },
        "section-mobile": { "$value": "56px", "$type": "dimension" },
        "gutter": { "$value": "{primitive.space.3}", "$type": "dimension" }
      },
      "size": {
        "touch-min": { "$value": "44px", "$type": "dimension" },
        "control-height": { "$value": "48px", "$type": "dimension" },
        "content-max": { "$value": "1200px", "$type": "dimension" }
      },
      "focus": {
        "ring-width": { "$value": "3px", "$type": "dimension" },
        "ring-offset": { "$value": "3px", "$type": "dimension" }
      }
    }
  },

  "component": {
    "ds": {
      "button": {
        "height": { "$value": "48px", "$type": "dimension" },
        "padding-x": { "$value": "24px", "$type": "dimension" },
        "radius": { "$value": "{primitive.radius.pill}", "$type": "dimension" },
        "primary-bg": { "$value": "{primitive.color.forest.700}", "$type": "color" },
        "primary-bg-hover": { "$value": "{primitive.color.forest.800}", "$type": "color" },
        "primary-fg": { "$value": "{primitive.color.white}", "$type": "color" },
        "outline-border": { "$value": "{primitive.color.forest.700}", "$type": "color" },
        "outline-fg": { "$value": "{primitive.color.forest.700}", "$type": "color" },
        "outline-bg-hover": { "$value": "{primitive.color.leaf.100}", "$type": "color" }
      },
      "card": {
        "bg": { "$value": "{primitive.color.white}", "$type": "color" },
        "radius": { "$value": "{primitive.radius.20}", "$type": "dimension" },
        "shadow": { "$value": "{primitive.shadow.sm}", "$type": "shadow" },
        "shadow-hover": { "$value": "{primitive.shadow.md}", "$type": "shadow" },
        "padding": { "$value": "24px", "$type": "dimension" }
      },
      "badge": {
        "available-bg": { "$value": "{primitive.color.leaf.100}", "$type": "color" },
        "available-fg": { "$value": "{primitive.color.forest.700}", "$type": "color" },
        "soon-bg": { "$value": "{primitive.color.terracotta.700}", "$type": "color" },
        "soon-fg": { "$value": "{primitive.color.white}", "$type": "color" },
        "tag-bg": { "$value": "{primitive.color.cream.100}", "$type": "color" },
        "tag-fg": { "$value": "{primitive.color.stone.900}", "$type": "color" }
      },
      "input": {
        "height": { "$value": "48px", "$type": "dimension" },
        "border": { "$value": "{primitive.color.stone.500}", "$type": "color" },
        "border-error": { "$value": "{primitive.color.red.700}", "$type": "color" },
        "radius": { "$value": "{primitive.radius.12}", "$type": "dimension" },
        "font-size": { "$value": "16px", "$type": "dimension", "$description": "Prevents iOS zoom" }
      },
      "header": {
        "bg": { "$value": "{primitive.color.white}", "$type": "color" },
        "active-indicator": { "$value": "{primitive.color.forest.700}", "$type": "color" }
      },
      "footer": {
        "bg": { "$value": "{primitive.color.forest.700}", "$type": "color" },
        "fg": { "$value": "{primitive.color.cream.50}", "$type": "color" },
        "accent": { "$value": "{primitive.color.gold.300}", "$type": "color" }
      }
    }
  }
}
