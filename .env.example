# Local Postgres (Homebrew or `docker compose up postgres`)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dsanga
# Long random string: openssl rand -hex 32
PAYLOAD_SECRET=
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Used only by `pnpm seed` (temporary data, spec §14)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Vendor test WhatsApp number, international format without + (never a random number)
SEED_WHATSAPP_NUMBER=
SEED_CONTACT_EMAIL=

# ── SEO ────────────────────────────────────────────────────────────────────────
# true ONLY on production, at build time AND runtime (pages bake the robots tag in at build).
# Anything else = noindex + robots.txt blocks everything (staging, local).
ALLOW_INDEXING=false
# Search Console HTML-tag verification code (content="…" value only). Optional.
GOOGLE_SITE_VERIFICATION=

# ── Analytics ──────────────────────────────────────────────────────────────────
# GA4 measurement ID (G-XXXXXXXXXX). Empty = no analytics and no cookie banner. Read at build time.
NEXT_PUBLIC_GA_ID=

# ── Email (contact form notifications) ─────────────────────────────────────────
# Empty SMTP_HOST = emails are written to the server log instead of sent (local development).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=D’Sanga website

# ── Media storage: Cloudflare R2 (S3-compatible) ───────────────────────────────
# Empty S3_BUCKET = files stay on local disk (./media, ./documents).
S3_BUCKET=
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public bucket URL (custom domain or r2.dev). Empty = files are served through /api/media/file/…
# Also read at build time (next/image allow-list).
S3_PUBLIC_URL=
